import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
import numpy as np

def alpha_train_and_evaluate(input_csv="merged_animals.csv", output_csv="eda_processed_animals.csv"):
    """
    Performs EDA:
    - Creates four visualizations
    - Performs statistical analysis
    - Saves processed dataset
    """

    # Load dataset
    df = pd.read_csv(input_csv)
    df.columns = [col.strip() for col in df.columns]  # clean column names

    print("Columns in dataset:\n", df.columns)

    # Identify columns
    class_col = 'Class_Type' if 'Class_Type' in df.columns else df.columns[df.columns.str.contains('class', case=False)][0]
    cons_col = 'conservation_status' if 'conservation_status' in df.columns else df.columns[df.columns.str.contains('conservation', case=False)][0]
    habitat_col = 'habitat' if 'habitat' in df.columns else df.columns[df.columns.str.contains('habitat', case=False)][0]

    # Numerical columns
    num_cols = df.select_dtypes(include=np.number).columns.tolist()
    top3_bio = num_cols[:3] if len(num_cols) >= 3 else num_cols

    # --- Visualization 1: Stacked bar chart Class vs Conservation Status ---
    plt.figure(figsize=(10,6))
    class_cons = pd.crosstab(df[class_col], df[cons_col])
    class_cons.plot(kind='bar', stacked=True)
    plt.title("Class Distribution by Conservation Status")
    plt.xlabel("Class")
    plt.ylabel("Count")
    plt.legend(title="Conservation Status")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig("stacked_bar_class_conservation.png")
    plt.show()

    # --- Visualization 2: Violin plot ---
    if top3_bio:
        plt.figure(figsize=(10,6))
        sns.violinplot(x=class_col, y=top3_bio[0], data=df, inner='quartile')
        plt.title(f"{top3_bio[0]} Distribution by Class")
        plt.xlabel("Class")
        plt.ylabel(top3_bio[0])
        plt.xticks(rotation=45)
        plt.tight_layout()
        plt.savefig(f"violin_{top3_bio[0]}_class.png")
        plt.show()

    # --- Visualization 3: Pairplot of top 3 biological features ---
    if len(top3_bio) >= 2:
        sns.pairplot(df[top3_bio + [class_col]], hue=class_col, diag_kind='kde')
        plt.suptitle("Pairplot of Top 3 Biological Features", y=1.02)
        plt.savefig("pairplot_top3_bio.png")
        plt.show()

    # --- Visualization 4: Heatmap habitat vs class ---
    plt.figure(figsize=(10,6))
    habitat_class = pd.crosstab(df[habitat_col], df[class_col])
    sns.heatmap(habitat_class, annot=True, fmt='d', cmap='YlGnBu')
    plt.title("Habitat vs Class Distribution")
    plt.xlabel("Class")
    plt.ylabel("Habitat")
    plt.xticks(rotation=45)
    plt.tight_layout()
    plt.savefig("heatmap_habitat_class.png")
    plt.show()

    # --- Statistical Analysis ---
    # Class imbalance ratio
    class_counts = df[class_col].value_counts()
    imbalance_ratio = class_counts.max() / class_counts.min()
    print("\nClass Imbalance Ratio:", imbalance_ratio)

    # Low variance features
    low_variance_features = [col for col in num_cols if df[col].var() < 0.01]
    print("\nLow Variance Features:", low_variance_features)

    # Highly correlated pairs
    corr_matrix = df[num_cols].corr()
    high_corr_pairs = []
    for i in corr_matrix.columns:
        for j in corr_matrix.columns:
            if i != j and abs(corr_matrix.loc[i,j]) > 0.8:
                pair_sorted = tuple(sorted([i,j]))
                if pair_sorted not in [(p[0],p[1]) for p in high_corr_pairs]:
                    high_corr_pairs.append((pair_sorted[0], pair_sorted[1], corr_matrix.loc[i,j]))
    print("\nHighly Correlated Pairs (|corr| > 0.8):")
    for pair in high_corr_pairs:
        print(pair)

    # --- Insight examples ---
    endangered_classes = df[df[cons_col].isin(['Vulnerable','Endangered','Critically Endangered'])]
    if not endangered_classes.empty:
        most_endangered_class = endangered_classes[class_col].value_counts().idxmax()
        print("\nMost endangered class:", most_endangered_class)

    most_biodiverse_habitat = df[habitat_col].value_counts().idxmax()
    print("Habitat with highest biodiversity:", most_biodiverse_habitat)

    # Save processed dataset
    df.to_csv(output_csv, index=False)
    print(f"\nProcessed dataset saved as '{output_csv}'.")


if __name__ == "__main__":
    alpha_train_and_evaluate()
