import json
import pandas as pd
import re
import numpy as np

def Alpha_load_and_integrate(output_csv="merged_output.csv"):

    try:
        df_zoo = pd.read_csv("zoo.csv", encoding="utf-8")
    except UnicodeDecodeError:
        df_zoo = pd.read_csv("zoo.csv", encoding="latin-1")

    df_class = pd.read_csv("class.csv")

    try:
        with open("auxiliary_metadata.json", "r", encoding="utf-8") as f:
            aux = json.load(f)
    except json.JSONDecodeError:
        with open("auxiliary_metadata.json", "r", encoding="utf-8", errors="ignore") as f:
            raw = f.read().strip().rstrip(",")
            aux = json.loads(raw)

    df_aux = pd.DataFrame(aux)

    zoo_name_col = "animal_name"
    class_name_col = "Animal_Names"

    json_possible_names = ["name", "animal_name", "animal", "AnimalName", "animalName"]
    aux_name_col = None
    for col in df_aux.columns:
        if col.lower() in [x.lower() for x in json_possible_names]:
            aux_name_col = col
            print(f"[OK] auxiliary JSON: detected name column → {col}")
            break

    if aux_name_col is None:
        raise ValueError("No valid name column found in auxiliary_metadata.json. "
                         f"Available columns: {df_aux.columns}")

    def normalize(x):
        if pd.isna(x):
            return ""
        x = str(x).lower()
        return re.sub(r"[^a-z0-9]", "", x)

    df_zoo["name_norm"] = df_zoo[zoo_name_col].apply(normalize)
    df_class["name_norm"] = df_class[class_name_col].apply(normalize)
    df_aux["name_norm"] = df_aux[aux_name_col].apply(normalize)

    merged = df_zoo.merge(
        df_class, on="name_norm", how="left", suffixes=("_zoo", "_class")
    )

    merged = merged.merge(
        df_aux, on="name_norm", how="left", suffixes=("", "_aux")
    )

    for col in merged.columns:
        if merged[col].dtype == "O":  
            merged[col] = merged[col].fillna("unknown")
        else:  
            median_val = merged[col].median()
            merged[col] = merged[col].fillna(median_val)

    endangered_statuses = ["vulnerable", "endangered", "critically endangered"]
    def endangered_flag(x):
        if str(x).lower() in endangered_statuses:
            return 1
        return 0

    if "conservation_status" in merged.columns:
        merged["is_endangered"] = merged["conservation_status"].apply(endangered_flag)
    else:
        merged["is_endangered"] = 0  
        
    diet_map = {
        "carnivore": 3,
        "omnivore": 2,
        "herbivore": 1
    }
    if "diet" in merged.columns:
        merged["diet_complexity"] = merged["diet"].apply(lambda x: diet_map.get(str(x).lower(), 0))
    else:
        merged["diet_complexity"] = 0

    merged.to_csv(output_csv, index=False)
    print(f"\nMerged dataset exported successfully as '{output_csv}'")

    return merged


if __name__ == "__main__":
    final = Alpha_load_and_integrate("merged_animals.csv")
    print(final.head())
